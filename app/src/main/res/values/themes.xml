<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Waypoint" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_dim</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorError">@color/warn</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_dim</item>
        <item name="android:textColorHint">@color/on_surface_dim</item>
    </style>

    <!-- One elevation level only: sheets sit above the map, nothing sits above sheets. -->
    <style name="Widget.Waypoint.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">6dp</item>
    </style>

    <style name="Widget.Waypoint.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.Waypoint.Button.Secondary">
        <item name="backgroundTint">@color/surface_raised</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="iconTint">@color/on_surface</item>
    </style>

    <style name="Widget.Waypoint.Button.Warn" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/warn</item>
        <item name="strokeColor">@color/warn</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Preset speed chips. Primary control on dashcam hardware, so 48dp minimum. -->
    <style name="Widget.Waypoint.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="backgroundTint">@color/chip_background</item>
        <item name="strokeColor">@color/chip_stroke</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Text.Waypoint.SectionHeader" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/on_surface_dim</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Text.Waypoint.Telemetry" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
