<?xml version="1.0" encoding="utf-8"?>
<!--
  Wide-screen variant of the running-simulation sheet, which is what landscape-locked dashcam
  hardware gets. Same controls as the portrait layout, folded into two columns so the sheet
  stays short and the map keeps most of the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <in.nulltheory.waypoint.ui.SegmentedProgressBar
            android:id="@+id/runProgress"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/runProgressPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:minWidth="44dp"
            android:textColor="@color/on_surface_dim"
            android:textSize="14sp"
            tools:text="3%" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left: the readout and the continuous control. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent"
                    android:textSize="40sp"
                    tools:text="120" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kmh"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/liveDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/dot_live" />

                <TextView
                    android:id="@+id/runStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="8dp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    tools:text="RUNNING" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/speedSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="150"
                app:labelBehavior="gone"
                app:thumbColor="@color/accent"
                app:tickVisible="false"
                app:trackColorActive="@color/accent"
                app:trackColorInactive="@color/accent_dim"
                app:trackHeight="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: the discrete controls, which are what actually gets used over scrcpy. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/presetRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip0"
                        style="@style/Widget.Waypoint.Chip"
                        android:checkable="true"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:text="0" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip20"
                        style="@style/Widget.Waypoint.Chip"
                        android:checkable="true"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:text="20" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip30"
                        style="@style/Widget.Waypoint.Chip"
                        android:checkable="true"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:text="30" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip50"
                        style="@style/Widget.Waypoint.Chip"
                        android:checkable="true"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:text="50" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip80"
                        style="@style/Widget.Waypoint.Chip"
                        android:checkable="true"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:text="80" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip120"
                        style="@style/Widget.Waypoint.Chip"
                        android:checkable="true"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:text="120" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Amber for the anomaly, accent for the return to normal. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brakeButton"
                    style="@style/Widget.Waypoint.Button.Event"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/brake"
                    android:textColor="@color/warn"
                    app:icon="@drawable/ic_brake"
                    app:iconGravity="textStart"
                    app:iconTint="@color/warn"
                    app:strokeColor="@color/warn" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recoverButton"
                    style="@style/Widget.Waypoint.Button.Event"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/recover"
                    android:textColor="@color/accent"
                    app:icon="@drawable/ic_recover"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent"
                    app:strokeColor="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pauseButton"
                    style="@style/Widget.Waypoint.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pause"
                    app:icon="@drawable/ic_pause"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    style="@style/Widget.Waypoint.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/stop"
                    app:icon="@drawable/ic_stop"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/runNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/route_complete"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/telemetry"
        style="@style/Text.Waypoint.Telemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        tools:text="12.9631, 77.7482 · 197° · 0.8/24.7 km" />
</LinearLayout>
