<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sheetContainer" />

    <!-- OSM data is ODbL. This has to be visible on the map itself, not only in Licenses. -->
    <TextView
        android:id="@+id/attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/bg_attribution"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="@string/attribution"
        android:textColor="#333333"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@id/map"
        app:layout_constraintStart_toStartOf="@id/map" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        style="@style/Widget.Waypoint.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settingsButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The origin, once chosen, collapses to this line so the box below is always
                 the one thing you are searching in right now. Tap it to go back and edit. -->
            <TextView
                android:id="@+id/originCrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="14dp"
                android:textColor="@color/on_surface_dim"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/dot_crumb"
                tools:text="From · Whitefield"
                tools:visibility="visible" />

            <!-- Replaces the search box once a run is under way: nothing is editable then,
                 so both endpoints collapse to matching one-line summaries and the map keeps
                 the space. -->
            <TextView
                android:id="@+id/destinationCrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="40dp"
                android:paddingStart="15dp"
                android:paddingEnd="14dp"
                android:textColor="@color/on_surface_dim"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/dot_crumb_filled"
                tools:text="To · Electronic City" />

            <LinearLayout
                android:id="@+id/rowSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <View
                    android:id="@+id/searchDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/dot_start" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_origin"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_dim"
                    android:textSize="16sp"
                    android:autofillHints="" />

                <ImageButton
                    android:id="@+id/clearSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_clear"
                    android:padding="12dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/on_surface_dim" />
            </LinearLayout>

            <TextView
                android:id="@+id/emptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:text="@string/search_empty_state"
                android:textColor="@color/on_surface_dim"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:listitem="@layout/item_place" />

            <ProgressBar
                android:id="@+id/searchProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:visibility="invisible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_field"
        android:contentDescription="@string/cd_settings"
        android:padding="12dp"
        android:src="@drawable/ic_tune"
        app:layout_constraintTop_toTopOf="@id/searchCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/on_surface" />

    <!-- Zoom stack, sitting above the locate button on the map's right edge. osmdroid's own
         zoom controls are disabled in favour of these: 48dp targets, same visual language as
         the other map controls, and reachable under a laggy mirrored pointer. -->
    <ImageButton
        android:id="@+id/zoomInButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_field"
        android:contentDescription="@string/cd_zoom_in"
        android:padding="12dp"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toTopOf="@id/zoomOutButton"
        app:layout_constraintEnd_toEndOf="@id/map"
        app:tint="@color/on_surface" />

    <ImageButton
        android:id="@+id/zoomOutButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_field"
        android:contentDescription="@string/cd_zoom_out"
        android:padding="12dp"
        android:src="@drawable/ic_remove"
        app:layout_constraintBottom_toTopOf="@id/locateButton"
        app:layout_constraintEnd_toEndOf="@id/map"
        app:tint="@color/on_surface" />

    <ImageButton
        android:id="@+id/locateButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_field"
        android:contentDescription="@string/cd_my_location"
        android:padding="12dp"
        android:src="@drawable/ic_my_location"
        app:layout_constraintBottom_toBottomOf="@id/map"
        app:layout_constraintEnd_toEndOf="@id/map"
        app:tint="@color/on_surface" />

    <!-- Screens 2 and 3 both live in here; only one child is visible at a time. -->
    <LinearLayout
        android:id="@+id/sheetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/directionsButton"
            style="@style/Widget.Waypoint.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/get_directions"
            android:visibility="gone" />

        <include
            android:id="@+id/sheetRoute"
            layout="@layout/sheet_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/sheetRun"
            layout="@layout/sheet_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
